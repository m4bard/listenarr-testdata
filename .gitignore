build/
.venv/
# dotnet intermediate output from tools/taglib_probe. Kept out on two grounds: it is build
# product, and the .nuget.g.props MSBuild writes there records the absolute path of the local
# NuGet cache, which is a home directory this repo must never carry.
obj/
bin/
__pycache__/
*.pyc
*.m4b
*.mp3
*.flac
*.m4a
*.aac
*.ogg
*.opus
*.wav
# ...but the cross-platform equivalence corpus is a committed, fixed test fixture (tiny,
# deterministic inputs every runner reads) — not generated library audio, so keep it.
!tests/fixtures/eqcorpus/*
CLAUDE.local.md
session-state.md
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
# run logs from the validate_* tools; they name local paths and prove nothing on their own
*.log
